<Window x:Class="MidiRouter.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Ustawienia" Width="620" Height="550" MinWidth="550" MinHeight="410" Background="#181B20" Foreground="#EFF2F5" WindowStartupLocation="CenterOwner">
 <Grid Margin="19.2"><Grid.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Grid.LayoutTransform><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,20"><TextBlock Text="Ustawienia" FontSize="23" FontWeight="SemiBold"/></StackPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"><ItemsControl ItemsSource="{Binding}"><ItemsControl.ItemTemplate><DataTemplate>
 <StackPanel Margin="0,0,14,18">
  <Border Background="#222830" CornerRadius="10" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,20,0"><TextBlock Text="PODSTAWOWE" Style="{StaticResource SectionTitle}"/><TextBlock Text="Nazwa" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
    <TextBlock Text="Tagi" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Oddziel przecinkami: Rack, KB, Mini, Modular" Foreground="#82909F" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
   </StackPanel>
   <Grid Grid.Column="1" MinHeight="224">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="GRAFIKA" Style="{StaticResource SectionTitle}"/>
    <Border Grid.Row="1" Background="#181D23" CornerRadius="8" Padding="8"><Image Source="{Binding Preview}" Stretch="Uniform"/></Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
     <Button Content="Wybierz" Width="88" Click="BrowseArtwork" FontSize="12" Padding="10,7"/>
     <Button Content="Usuń" Width="88" Click="ClearArtwork" FontSize="12" Padding="10,7" Margin="8,0,0,0"/>
    </StackPanel>
   </Grid>
  </Grid></Border>
  <Border Background="#222830" CornerRadius="10" Padding="18" Margin="0,12,0,0"><StackPanel>
   <TextBlock Text="POŁĄCZENIE MIDI" Style="{StaticResource SectionTitle}"/>
   <Grid HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="260"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><TextBlock Text="Interfejs" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding Interface, Mode=TwoWay}"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="Port" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PortOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="False"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,0,0"><TextBlock Text="Kanał" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding ChannelText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   </Grid>
  </StackPanel></Border>
 </StackPanel>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 <TextBlock x:Name="Error" Grid.Row="2" Foreground="#F0A49F" TextWrapping="Wrap" Margin="0,10"/>
 <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Anuluj" IsCancel="True" Margin="0,0,10,0"/><Button Content="Zapisz" IsDefault="True" Click="SaveSettings" Background="#234A38"/></StackPanel>
 </Grid>
</Window>





