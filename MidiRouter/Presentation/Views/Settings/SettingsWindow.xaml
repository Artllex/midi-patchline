<Window x:Class="MidiRouter.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Ustawienia" Width="620" Height="550" MinWidth="550" MinHeight="410" Background="#181B20" Foreground="#EFF2F5" WindowStartupLocation="CenterOwner">
 <Window.Resources><Style x:Key="ArtworkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#323A43"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#30463B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style></Window.Resources>
 <Grid Margin="19.2"><Grid.LayoutTransform><ScaleTransform ScaleX="0.85" ScaleY="0.85"/></Grid.LayoutTransform><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,20"><TextBlock Text="Ustawienia" FontSize="23" FontWeight="SemiBold"/></StackPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"><ItemsControl ItemsSource="{Binding}"><ItemsControl.ItemTemplate><DataTemplate>
 <StackPanel Margin="0,0,14,18">
  <Border Background="#222830" CornerRadius="10" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="BasicFields" Margin="0,0,20,0"><TextBlock Text="PODSTAWOWE" Style="{StaticResource SectionTitle}"/><TextBlock Text="Nazwa" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
    <TextBlock Text="Tagi" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/><TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Oddziel przecinkami: Rack, KB, Mini, Modular" Foreground="#82909F" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <StackPanel Visibility="{Binding SourceVisibility}" Margin="0,14,0,0">
   <StackPanel Orientation="Horizontal">
    <StackPanel Width="140" Margin="0,0,12,0">
     <TextBlock Text="Typ" Style="{StaticResource FieldLabel}"/>
     <ComboBox ToolTip="{Binding DetectionMessage}" ItemsSource="{Binding SourceTypes}" SelectedItem="{Binding SourceType, Mode=TwoWay}"/>
    </StackPanel>
    <StackPanel Width="110" Margin="0,0,0,0" Visibility="{Binding KeyboardVisibility}">
     <TextBlock Text="Liczba klawiszy" Style="{StaticResource FieldLabel}"/>
     <ComboBox ItemsSource="{Binding KeyCounts}" IsEditable="True" Text="{Binding KeyCountText, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>

   </StackPanel>

    </StackPanel>
   </StackPanel>
   <Grid Grid.Column="1" Height="{Binding ActualHeight, ElementName=BasicFields}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="GRAFIKA" Style="{StaticResource SectionTitle}"/>
    <Border Grid.Row="1" Background="#181D23" CornerRadius="8" Padding="8"><Image Source="{Binding Preview}" Stretch="Uniform"/></Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
     <Button Style="{StaticResource ArtworkButton}" Content="Wybierz" Width="88" Click="BrowseArtwork" FontSize="12" Padding="10,7"/>
     <Button Style="{StaticResource ArtworkButton}" Content="Usuń" Width="88" Click="ClearArtwork" FontSize="12" Padding="10,7" Margin="8,0,0,0"/>
    </StackPanel>
   </Grid>
  </Grid></Border>

  <Border Background="#222830" CornerRadius="10" Padding="18" Margin="0,12,0,0"><StackPanel>
   <TextBlock Text="POŁĄCZENIE MIDI" Style="{StaticResource SectionTitle}"/>
   <Grid HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="260"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><TextBlock Text="Interfejs" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding Interface, Mode=TwoWay}"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="Port" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding PortOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="False"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,0,0"><TextBlock Text="Kanał" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding ChannelText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   </Grid>
  </StackPanel></Border>
 </StackPanel>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 <TextBlock x:Name="Error" Grid.Row="2" Foreground="#F0A49F" TextWrapping="Wrap" Margin="0,10"/>
 <StackPanel Grid.Row="3" Loaded="SettingsFooterLoaded" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Anuluj" IsCancel="True" Margin="0,0,10,0"/><Button Content="Zastosuj" Tag="apply" Click="SaveSettings" Margin="0,0,10,0"/><Button Content="Zapisz" IsDefault="True" Click="SaveSettings"/></StackPanel>
 </Grid>
</Window>





